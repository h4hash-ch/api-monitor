{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types", "vitest/globals", "vite/client"]
  },
  "include": [
    "src",
    "frontend",
    "tests",
    "frontend/vite.config.ts"
  ]
}
