# Cloudflare Worker / Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key

# Worker variables (also configured in wrangler.toml)

# Local development
APP_ORIGIN=http://localhost:5173

# Production:
# APP_ORIGIN=https://your-worker-subdomain.workers.dev

MAX_SCHEDULE_BATCH=25
MAX_SCHEDULE_BATCHES=2
CHECK_CONCURRENCY=5
STATISTICS_CACHE_TTL_SECONDS=180

# Local development only. Do not enable for the deployed capstone Worker.
ALLOW_ONE_MINUTE_INTERVAL=false
