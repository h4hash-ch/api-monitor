{
  "name": "10x-api-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:types": "supabase gen types typescript --local > src/db/database.types.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@supabase/supabase-js": "^2.49.1",
    "hono": "^4.7.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wrangler": "^4.125.0"
  }
}
